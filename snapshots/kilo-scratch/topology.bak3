<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Topology Lab — editor ```topology</title>
<link rel="stylesheet" href="css/topo.css?v=1">
<style>
  :root {
    --bg: #0a0e13;
    --bg-2: #0e141b;
    --bg-3: #121a23;
    --panel: rgba(17, 23, 32, 0.94);
    --line: #1e2833;
    --line-2: #2b3948;
    --text: #e6edf3;
    --muted: #93a1b1;
    --dim: #66748a;
    --accent: #58a6ff;
    --accent-ink: #06101c;
    --back: #3fb950;
    --danger: #f85149;
    --warn: #d29922;
    --r-sm: 8px;
    --r: 12px;
    --r-lg: 16px;
    --bar: 56px;
    --tabs-h: 52px;
    --shadow: 0 20px 50px rgba(0, 0, 0, 0.55);
    --ring: 0 0 0 3px rgba(88, 166, 255, 0.22);
  }

  * { box-sizing: border-box; }

  html, body {
    height: 100%;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 13px/1.55 ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    -webkit-font-smoothing: antialiased;
    overflow: hidden;
  }

  .mono, code, kbd, .inp.code {
    font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
  }

  /* ============================================================ top bar */

  .topbar {
    position: fixed;
    inset: 0 0 auto 0;
    height: var(--bar);
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 12px 0 14px;
    background: rgba(10, 14, 19, 0.9);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--line);
    z-index: 60;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    text-decoration: none;
    color: inherit;
    flex: 0 0 auto;
    border-radius: var(--r-sm);
  }

  .brand-avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--line-2);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .brand-name {
    font-size: 13.5px;
    font-weight: 680;
    letter-spacing: -0.15px;
  }

  .brand-name span { color: var(--accent); }

  .brand-sub {
    font-size: 10px;
    color: var(--dim);
    letter-spacing: 0.02em;
  }

  .top-sep {
    width: 1px;
    height: 22px;
    background: var(--line-2);
    flex: 0 0 auto;
  }

  .title-wrap {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    flex: 1 1 auto;
  }

  .doc-title {
    min-width: 0;
    width: 100%;
    max-width: 420px;
    height: 32px;
    padding: 0 10px;
    border: 1px solid transparent;
    border-radius: var(--r-sm);
    background: transparent;
    color: var(--text);
    font: 600 14px/1 inherit;
    letter-spacing: -0.15px;
  }

  .doc-title:hover { background: var(--bg-3); }

  .doc-title:focus {
    outline: none;
    background: var(--bg-3);
    border-color: var(--accent);
    box-shadow: var(--ring);
  }

  .top-status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 24px;
    padding: 0 9px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg-2);
    color: var(--muted);
    font-size: 11px;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    flex: 0 0 auto;
  }

  .top-status::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--back);
  }

  .top-nav {
    display: flex;
    align-items: center;
    gap: 2px;
    margin-left: auto;
    flex: 0 0 auto;
  }

  .top-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 32px;
    padding: 0 10px;
    border-radius: var(--r-sm);
    color: var(--muted);
    text-decoration: none;
    font-size: 12.5px;
    font-weight: 550;
    white-space: nowrap;
  }

  .top-link .ico {
    font-size: 13px;
    line-height: 1;
    opacity: 0.85;
  }

  .top-link:hover {
    background: var(--bg-3);
    color: var(--text);
  }

  .top-right {
    display: flex;
    align-items: center;
    gap: 6px;
    flex: 0 0 auto;
  }

  /* ============================================================= buttons */

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    height: 32px;
    padding: 0 12px;
    border: 1px solid var(--line-2);
    border-radius: var(--r-sm);
    background: var(--bg-3);
    color: var(--text);
    font: 600 12.5px/1 inherit;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.14s, border-color 0.14s, color 0.14s;
  }

  .btn:hover { background: #18222e; border-color: #3a4c60; }

  .btn:focus-visible { outline: none; box-shadow: var(--ring); }

  .btn--sm { height: 30px; padding: 0 10px; font-size: 12px; }

  .btn--primary {
    background: var(--accent);
    border-color: transparent;
    color: var(--accent-ink);
  }

  .btn--primary:hover { background: #79b8ff; border-color: transparent; }

  .btn--ghost {
    background: transparent;
    border-color: transparent;
    color: var(--muted);
  }

  .btn--ghost:hover { background: var(--bg-3); color: var(--text); }

  .btn--icon { width: 30px; padding: 0; }

  .btn--danger { color: var(--danger); border-color: transparent; background: transparent; }

  .btn--danger:hover { background: rgba(248, 81, 73, 0.12); color: #ff7b72; }

  .copy-short { display: none; }

  /* =============================================================== stage */

  #stage {
    position: fixed;
    top: var(--bar);
    left: 0;
    right: 0;
    bottom: 0;
    overflow: auto;
    background-color: var(--bg);
    background-image:
      linear-gradient(rgba(88, 166, 255, 0.055) 1px, transparent 1px),
      linear-gradient(90deg, rgba(88, 166, 255, 0.055) 1px, transparent 1px);
    background-size: 22px 22px;
    background-position: -1px -1px;
    transition: right 0.22s ease, bottom 0.22s ease;
  }

  #stage.is-guides {
    background-image:
      linear-gradient(rgba(88, 166, 255, 0.055) 1px, transparent 1px),
      linear-gradient(90deg, rgba(88, 166, 255, 0.055) 1px, transparent 1px),
      linear-gradient(rgba(88, 166, 255, 0.11) 1px, transparent 1px),
      linear-gradient(90deg, rgba(88, 166, 255, 0.11) 1px, transparent 1px);
    background-size: 22px 22px, 22px 22px, 110px 110px, 110px 110px;
  }

  #board {
    position: relative;
    min-height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 32px 24px calc(var(--tabs-h) + 48px);
  }

  /* 670px = --article-measure di css/article.css. Editor dan artikel harus
     punya lebar sama supaya yang di kanvas persis yang terbit. */
  #preview {
    width: 100%;
    max-width: 670px;
    margin: 0 auto;
  }

  #preview .tp { margin: 0; }

  #empty {
    max-width: 380px;
    margin: 0;
    padding: 26px 22px;
    border: 1px dashed var(--line-2);
    border-radius: var(--r);
    background: rgba(255, 255, 255, 0.015);
    color: var(--muted);
    font-size: 12.5px;
    text-align: center;
  }

  #empty b { color: var(--text); }

  #board.is-empty #preview { display: none; }

  /* ============================================================ dock tabs */

  #dockTabs {
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 0 8px;
    border-bottom: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.015);
    overflow-x: auto;
    scrollbar-width: none;
    flex: 0 0 auto;
  }

  #dockTabs::-webkit-scrollbar { display: none; }

  .dock-tab {
    position: relative;
    height: 36px;
    padding: 0 11px;
    border: 0;
    background: transparent;
    color: var(--muted);
    font: 600 12px/1 inherit;
    cursor: pointer;
    white-space: nowrap;
    transition: color 0.14s;
  }

  .dock-tab::after {
    content: "";
    position: absolute;
    left: 8px;
    right: 8px;
    bottom: -1px;
    height: 2px;
    border-radius: 2px 2px 0 0;
    background: transparent;
    transition: background 0.14s;
  }

  .dock-tab:hover { color: var(--text); }

  .dock-tab.is-on { color: var(--text); }

  .dock-tab.is-on::after { background: var(--accent); }

  /* Pembuka inspector — hanya tampil saat inspector tertutup. */
  .dock-open {
    position: fixed;
    left: 50%;
    bottom: 18px;
    transform: translateX(-50%);
    height: 38px;
    padding: 0 18px;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    background: var(--panel);
    backdrop-filter: blur(18px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.45);
    color: var(--text);
    font: 600 12.5px/1 inherit;
    cursor: pointer;
    z-index: 80;
    display: none;
  }

  .dock-open:hover { border-color: var(--accent); }

  #dock:not(.is-open) ~ .dock-open { display: block; }

  .dock-tab.is-on {
    background: var(--accent);
    color: var(--accent-ink);
  }

  /* ================================================================= dock */

  /* Inspector: kolom tetap di kanan pada desktop, bottom sheet di layar sempit.
     Satu tempat untuk semua panel, jadi tidak ada panel yang menutupi kanvas. */
  #dock {
    position: fixed;
    z-index: 70;
    top: var(--bar);
    right: 0;
    bottom: 0;
    width: min(400px, 100vw);
    display: none;
    flex-direction: column;
    background: var(--panel);
    backdrop-filter: blur(20px);
    border: 1px solid var(--line-2);
    border-right: 0;
    border-radius: 16px 0 0 16px;
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  #dock.is-open { display: flex; }

  @media (min-width: 1001px) {
    #dock { display: flex; }
    #dockClose { display: none; }
    #board { padding-bottom: 40px; }
  }

  #dock.is-dragging { transition: none; }

  .dock-head {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 42px;
    padding: 0 8px 0 14px;
    border-bottom: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.02);
    flex: 0 0 auto;
  }

  .dock-head b {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .dock-head .spacer { flex: 1 1 auto; }

  .icon-btn {
    display: inline-grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border: 0;
    border-radius: var(--r-sm);
    background: transparent;
    color: var(--dim);
    font-size: 13px;
    cursor: pointer;
  }

  .icon-btn:hover { background: var(--bg-3); color: var(--text); }

  .dock-resize {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 16px;
    height: 16px;
    cursor: nwse-resize;
    background:
      linear-gradient(135deg, transparent 50%, var(--line-2) 50%, var(--line-2) 60%, transparent 60%,
        transparent 72%, var(--line-2) 72%, var(--line-2) 82%, transparent 82%);
    opacity: 0.8;
  }

  .dock-body {
    flex: 1 1 auto;
    overflow: auto;
    padding: 14px 16px 18px;
    overscroll-behavior: contain;
  }

  /* ================================================================ panes */

  .pane { display: none; }

  .pane.is-on { display: block; }

  .sec + .sec {
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }

  .sec-h {
    margin: 0 0 10px;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .hint {
    margin: 0 0 12px;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.6;
  }

  .hint code {
    padding: 1px 5px;
    border-radius: 5px;
    background: var(--bg-3);
    color: var(--text);
    font-size: 11px;
  }

  .hint b { color: var(--text); font-weight: 600; }

  .row {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .grid2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .grid3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 5px;
    min-width: 0;
  }

  .field > span {
    font-size: 11px;
    color: var(--muted);
  }

  .inp {
    width: 100%;
    height: 32px;
    padding: 0 10px;
    border: 1px solid var(--line-2);
    border-radius: var(--r-sm);
    background: var(--bg);
    color: var(--text);
    font: 12.5px/1.4 inherit;
  }

  .inp:hover { border-color: #3a4c60; }

  .inp:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: var(--ring);
  }

  textarea.inp {
    height: auto;
    min-height: 280px;
    padding: 10px;
    line-height: 1.6;
    resize: vertical;
    white-space: pre;
    overflow: auto;
    font-size: 12px;
  }

  .inp.code { font-size: 12px; }

  select.inp { appearance: none; cursor: pointer; }

  .switch {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 10px;
    color: var(--muted);
    font-size: 12px;
    cursor: pointer;
    user-select: none;
  }

  .switch input {
    appearance: none;
    width: 30px;
    height: 17px;
    border-radius: 999px;
    background: var(--line-2);
    position: relative;
    cursor: pointer;
    transition: background 0.15s;
    flex: 0 0 auto;
  }

  .switch input::after {
    content: "";
    position: absolute;
    top: 2px;
    left: 2px;
    width: 13px;
    height: 13px;
    border-radius: 50%;
    background: #c9d4e0;
    transition: transform 0.15s;
  }

  .switch input:checked { background: var(--accent); }

  .switch input:checked::after { transform: translateX(13px); background: #fff; }

  .seg {
    display: inline-flex;
    padding: 2px;
    border: 1px solid var(--line-2);
    border-radius: var(--r-sm);
    background: var(--bg);
    gap: 2px;
  }

  .seg button {
    flex: 1 1 0;
    height: 26px;
    padding: 0 10px;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: var(--muted);
    font: 600 12px/1 inherit;
    cursor: pointer;
  }

  .seg button:hover { color: var(--text); }

  .seg button.is-on {
    background: var(--accent);
    color: var(--accent-ink);
  }

  /* ================================================================ cards */

  #nodeList, #edgeList {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 10px;
  }

  .card {
    border: 1px solid var(--line);
    border-radius: var(--r);
    background: var(--bg-2);
    padding: 10px;
    transition: border-color 0.14s, background 0.14s;
  }

  .card:hover { border-color: var(--line-2); }

  .card.is-on {
    border-color: var(--accent);
    background: rgba(88, 166, 255, 0.06);
  }

  .card.is-drop {
    border-color: var(--back);
    background: rgba(63, 185, 80, 0.08);
  }

  .card-head {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }

  .card-head b {
    font-size: 12.5px;
    font-weight: 620;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex: 0 0 auto;
  }

  .id {
    font-size: 10.5px;
    color: var(--dim);
  }

  .edge-line {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 6px;
    margin-bottom: 8px;
  }

  .arw {
    color: var(--dim);
    font-size: 13px;
    line-height: 1;
  }

  /* ============================================================== swatches */

  .swatches {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .sw {
    width: 22px;
    height: 22px;
    padding: 0;
    border: 1px solid var(--line-2);
    border-radius: 6px;
    cursor: pointer;
  }

  .sw:hover { transform: translateY(-1px); }

  .sw.is-on {
    box-shadow: var(--ring);
    border-color: var(--accent);
  }

  .sw--none {
    background:
      linear-gradient(45deg, transparent 44%, var(--danger) 44%, var(--danger) 56%, transparent 56%),
      var(--bg-3);
  }

  /* ================================================================ logos */

  .logo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(58px, 1fr));
    gap: 8px;
  }

  .tile {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    padding: 6px;
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    background: var(--bg-2);
    cursor: grab;
    transition: border-color 0.14s, background 0.14s;
  }

  .tile:hover {
    border-color: var(--accent);
    background: rgba(88, 166, 255, 0.08);
  }

  .tile img {
    max-width: 26px;
    max-height: 26px;
    object-fit: contain;
  }

  /* ================================================================ status */

  .code-status {
    min-height: 16px;
    margin: 8px 0 0;
    font-size: 11.5px;
    color: var(--dim);
  }

  .code-status.is-ok { color: var(--back); }

  .code-status.is-bad { color: var(--danger); }

  /* ================================================================= toast */

  #toast {
    position: fixed;
    left: 50%;
    bottom: 88px;
    transform: translate(-50%, 10px);
    padding: 8px 14px;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    background: var(--panel);
    backdrop-filter: blur(14px);
    color: var(--text);
    font-size: 12px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.18s, transform 0.18s;
    z-index: 90;
    max-width: calc(100vw - 32px);
  }

  #toast.is-on {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  body.is-panel-dragging { user-select: none; }

  /* ============================================================ responsive */

  @media (max-width: 1100px) {
    .brand-sub { display: none; }
    .top-link .lbl { display: none; }
    .top-link { padding: 0 9px; }
    #preview { max-width: 100%; }
  }

  @media (max-width: 900px) {
    #dock {
      left: 0;
      right: 0;
      top: auto;
      bottom: 0;
      width: auto;
      height: min(62vh, 520px);
      border-radius: 16px 16px 0 0;
      border-right: 1px solid var(--line-2);
    }

    .doc-title { max-width: none; font-size: 13px; }

    .top-status { display: none; }

    .top-sep { display: none; }
  }

  @media (max-width: 600px) {
    .topbar { gap: 6px; padding: 0 8px 0 10px; }
    .brand-text { display: none; }
    .brand-avatar { width: 26px; height: 26px; }
    .top-nav { gap: 0; }
    .top-link { height: 30px; padding: 0 8px; }
    .top-right { gap: 4px; }
    .btn--sm { padding: 0 9px; }
    .copy-long { display: none; }
    .copy-short { display: inline; }

    #board { padding: 24px 12px calc(var(--tabs-h) + 46px); }

    .dock-tab { height: 34px; padding: 0 9px; font-size: 11.5px; }
    .dock-open { bottom: 14px; }

    #dock {
      height: min(66vh, 500px);
    }

    #board { padding: 20px 10px calc(var(--tabs-h) + 40px); }
    #preview { max-width: 100%; }

    .dock-resize { display: none; }

    .grid2, .grid3 { grid-template-columns: 1fr; }

    #toast { bottom: 76px; }
  }

  @media (prefers-reduced-motion: reduce) {
    * { transition: none !important; }
  }
</style>
</head>
<body>

<header class="topbar">
  <a class="brand" href="index.html#home" title="Topology Lab — home">
    <img class="brand-avatar" src="assets/foto-raja.jpg" alt="" decoding="async">
    <span class="brand-text">
      <span class="brand-name">Topology Lab<span>.</span></span>
      <span class="brand-sub">by iMoon07</span>
    </span>
  </a>

  <span class="top-sep" aria-hidden="true"></span>

  <div class="title-wrap">
    <input id="docTitle" class="doc-title" value="Topology" aria-label="Diagram title" spellcheck="false">
    <span id="topStatus" class="top-status">0 node · 0 edge</span>
  </div>

  <nav class="top-nav" aria-label="Site">
    <a class="top-link" href="index.html#home" title="Home"><span class="ico" aria-hidden="true">⌂</span><span class="lbl">Home</span></a>
    <a class="top-link" href="references.html?ref=index" title="Docs"><span class="ico" aria-hidden="true">▤</span><span class="lbl">Docs</span></a>
    <a class="top-link" href="about.html" title="About"><span class="ico" aria-hidden="true">☺</span><span class="lbl">About</span></a>
    <a class="top-link" href="draw.html" title="Canvas editor"><span class="ico" aria-hidden="true">✎</span><span class="lbl">Draw</span></a>
  </nav>

  <div class="top-right">
    <button class="btn btn--primary btn--sm" id="copyBtn" aria-label="Copy the topology block"><span class="copy-long">Copy block</span><span class="copy-short">Copy</span></button>
  </div>
</header>

<main id="stage">
  <div id="board">
    <div id="preview" class="topology"></div>

    <p id="empty">No nodes yet. Add one from the <b>Nodes</b> panel, or load a <b>starter</b> diagram.</p>

  </div>
</main>

<aside id="dock" data-side="bottom" aria-label="Editor panel">
  <div class="dock-head" id="dockHead">
    <b id="dockTitle">Nodes</b>
    <span class="spacer"></span>
    <button class="icon-btn" id="dockClose" title="Close panel" aria-label="Close panel">✕</button>
  </div>

  <nav class="dock-tabs" id="dockTabs" role="tablist" aria-label="Editor panels">
    <button class="dock-tab is-on" data-pane="nodes" role="tab">Nodes</button>
    <button class="dock-tab" data-pane="edges" role="tab">Edges</button>
    <button class="dock-tab" data-pane="look" role="tab">Look</button>
    <button class="dock-tab" data-pane="logos" role="tab">Logos</button>
    <button class="dock-tab" data-pane="json" role="tab">Source</button>
  </nav>
  <div class="dock-resize" id="dockResize" title="Drag to resize"></div>

  <div class="dock-body">
    <!-- ------------------------------------------------------------ nodes -->
    <section class="pane is-on" data-pane="nodes">
      <div class="sec">
        <h3 class="sec-h">Starter</h3>
        <select id="presetSel" class="inp" title="Insert a starter diagram — replaces the current one">
          <option value="">Insert a starter…</option>
        </select>
      </div>

      <div class="sec">
        <h3 class="sec-h">Nodes</h3>
        <p class="hint">Click a card to select it, then drop a logo from <b>Logos</b> onto it. The column sets the position: 1 = left, 2 = middle, and so on.</p>
        <div id="nodeList"></div>
        <button class="btn btn--sm" id="addNode" style="width:100%">＋ Add node</button>
      </div>
    </section>

    <!-- ------------------------------------------------------------ edges -->
    <section class="pane" data-pane="edges">
      <p class="hint">One edge per row. The <b>label</b> is the text on the wire (e.g. <code>POST /order</code>), and <b>back</b> draws the return path.</p>
      <div id="edgeList"></div>
      <button class="btn btn--sm" id="addEdge" style="width:100%">＋ Add edge</button>
    </section>

    <!-- ------------------------------------------------------------- look -->
    <section class="pane" data-pane="look">
      <div class="sec">
        <h3 class="sec-h">Layout</h3>
        <label class="field"><span>Title</span>
          <input id="fTitle" class="inp" type="text" placeholder="Diagram title">
        </label>
        <div class="field" style="margin-top:10px"><span>Direction</span>
          <div class="seg" id="fVertical" role="group">
            <button type="button" data-v="1" class="is-on">Vertical</button>
            <button type="button" data-v="0">Horizontal</button>
          </div>
        </div>
        <label class="switch"><input id="fBadges" type="checkbox"> Show edge numbers</label>
        <label class="switch"><input id="guidesBtn" type="checkbox"> Alignment guides</label>
      </div>

      <div class="sec">
        <h3 class="sec-h">Flow labels</h3>
        <p class="hint">These name the direction of travel, not decoration. They can be shared by every forward and return wire.</p>
        <div class="grid2">
          <label class="field"><span>Flow</span>
            <input id="fFlow" class="inp" type="text" placeholder="Request">
          </label>
          <label class="field"><span>Back</span>
            <input id="fBack" class="inp" type="text" placeholder="Response">
          </label>
        </div>
        <div class="row" style="margin-top:10px;flex-wrap:wrap">
          <button class="btn btn--sm" id="applyCtx">Apply to every edge</button>
          <button class="btn btn--sm btn--ghost" id="clearCtx">Clear</button>
        </div>
      </div>

      <div class="sec">
        <h3 class="sec-h">Default for new edges</h3>
        <div class="field"><span>Colour</span><div class="swatches" id="defSwatches"></div></div>
        <div class="grid2" style="margin-top:10px">
          <label class="field"><span>Width</span>
            <input id="defWidth" class="inp" type="number" min="1" max="8" step="0.5" value="2">
          </label>
          <label class="field"><span>Style</span>
            <select id="defDash" class="inp">
              <option value="solid">solid</option>
              <option value="dashed">dashed</option>
              <option value="dotted">dotted</option>
            </select>
          </label>
        </div>
        <label class="field" style="margin-top:10px"><span>Motion</span>
          <select id="defMotion" class="inp">
            <option value="flow">flow — dots travel</option>
            <option value="none">none — static</option>
          </select>
        </label>
      </div>

      <div class="sec">
        <h3 class="sec-h">Groups</h3>
        <p class="hint">A group is a heading plus the nodes indented under it.</p>
        <label class="field"><span>Heading</span>
          <input id="fFacLabel" class="inp" type="text" placeholder="On one machine">
        </label>
        <div id="facList" style="margin-top:10px"></div>
        <button class="btn btn--sm" id="addFac" style="width:100%;margin-top:10px">＋ Add chip</button>
      </div>
    </section>

    <!-- ------------------------------------------------------------ logos -->
    <section class="pane" data-pane="logos">
      <p class="hint">Drag a logo onto a node, or click it to apply it to the selected node.</p>
      <input id="logoSearch" class="inp" type="search" placeholder="Search logos — docker, nginx, burp…">
      <div style="height:10px"></div>
      <select id="logoCat" class="inp"></select>
      <div style="height:12px"></div>
      <div id="logoGrid" class="logo-grid"></div>
    </section>

    <!-- ----------------------------------------------------------- source -->
    <section class="pane" data-pane="json">
      <p class="hint">This is the whole diagram. Edit it directly and the canvas follows as you type. Indent with <b>two spaces</b>.</p>
      <textarea id="specBox" class="inp code" spellcheck="false" wrap="off"></textarea>
      <div class="row" style="margin-top:10px">
        <button class="btn btn--sm" id="exportBtn" title="Download this diagram as topology.md">Export .md</button>
      </div>
      <p class="code-status" id="codeStatus"></p>
    </section>
  </div>
</aside>

<button class="dock-open" id="dockOpen" aria-controls="dock" aria-expanded="false">Edit diagram</button>

<div class="toast" id="toast"></div>

<script src="js/topology-icons.js?v=6"></script>
<script src="js/topo-lang.js?v=1"></script>
<script src="js/logo-manifest.js"></script>
<script src="js/alur/logos.js?v=5"></script>
<script src="js/topo.js?v=1"></script>
<script>
(function () {
  'use strict';

  var SAVE_KEY = 'topology.lab.v2';
  var TONES = [
    ['blue', '#58a6ff'], ['green', '#3fb950'], ['amber', '#d29922'],
    ['red', '#f85149'], ['purple', '#bc8cff'], ['cyan', '#39d0d8'],
    ['pink', '#f778ba'], ['slate', '#8b949e']
  ];
  var KINDS = ['process', 'actor', 'store', 'choice', 'out', 'tech', 'host',
    'client', 'server', 'database', 'cloud', 'security', 'network'];

  var PRESETS = [
    {
      id: 'request-response',
      label: 'Request / Response',
      spec: {
        title: 'Request / Response',
        vertical: true,
        columns: [['C'], ['P'], ['K']],
        nodes: {
          C: ['Customer', 'browser', 'customer', 'client', 'https://en.wikipedia.org/wiki/Web_browser'],
          P: ['API', 'node', 'waiter', 'process', 'https://en.wikipedia.org/wiki/Web_server'],
          K: ['Database', 'postgres', 'warehouse', 'database', 'https://en.wikipedia.org/wiki/Database']
        },
        edges: [
          { from: 'C', to: 'P', badge: 'Request', color: 'blue' },
          { from: 'P', to: 'K', badge: 'Query', color: 'cyan' },
          { from: 'K', to: 'P', badge: 'Rows', back: true },
          { from: 'P', to: 'C', badge: 'Response', back: true }
        ],
        legend: { flow: 'Request', back: 'Response' },
        facilitiesLabel: 'On one machine',
        facilities: [['server', 'Core'], ['lock', 'Transport'], ['package', 'Optional']]
      }
    },
    {
      id: 'chain',
      label: 'Linear chain',
      spec: {
        title: 'Linear chain',
        vertical: true,
        columns: [['C'], ['P'], ['K'], ['G']],
        nodes: {
          C: ['Customer', 'Places an order', 'customer', 'actor'],
          P: ['Waiter', 'Takes the order', 'waiter', 'process'],
          K: ['Chef', 'Prepares the order', 'cook', 'process'],
          G: ['Pantry', 'Stores ingredients', 'warehouse', 'store']
        },
        edges: [
          { from: 'C', to: 'P', badge: 'Order' },
          { from: 'P', to: 'K', badge: 'Ticket' },
          { from: 'K', to: 'G', badge: 'Fetch' },
          { from: 'G', to: 'K', badge: 'Items', back: true },
          { from: 'K', to: 'P', badge: 'Dish', back: true },
          { from: 'P', to: 'C', badge: 'Serve', back: true }
        ],
        legend: { flow: 'Request', back: 'Response' }
      }
    },
    {
      id: 'fan',
      label: 'Fan-out grid',
      spec: {
        title: 'Choose a platform',
        vertical: true,
        columns: [['B'], { nodes: ['C', 'D', 'E', 'F'], grid: 2 }, ['I']],
        nodes: {
          B: ['Where to run it?', '', 'git-branch', 'choice'],
          C: ['Bare Metal', 'Own hardware', 'hard-drive', 'host'],
          D: ['Virtual Machine', 'Private room', 'monitor', 'host'],
          E: ['Container', 'Shared kernel', 'si-docker', 'host'],
          F: ['Serverless', 'Per request', 'zap', 'host'],
          I: ['All components', 'Run in one place', 'layers', 'out']
        },
        edges: [
          { from: 'B', to: 'C' }, { from: 'B', to: 'D' },
          { from: 'B', to: 'E' }, { from: 'B', to: 'F' },
          { from: 'C', to: 'I', back: true }, { from: 'D', to: 'I', back: true },
          { from: 'E', to: 'I', back: true }, { from: 'F', to: 'I', back: true }
        ]
      }
    },
    {
      id: 'stack',
      label: 'Stack with logos',
      spec: {
        title: 'Request path',
        vertical: false,
        columns: [['client'], ['edge'], ['app'], ['db']],
        nodes: {
          client: ['Client', 'browser', 'customer', 'client'],
          edge: ['Edge', 'nginx', 'stack:nginx', 'server'],
          app: ['App', 'node', 'programming:nodejs', 'process'],
          db: ['Database', 'postgres', 'stack:postgresql', 'database']
        },
        edges: [
          { from: 'client', to: 'edge', badge: 'TLS', color: 'green', width: 2.5 },
          { from: 'edge', to: 'app', badge: 'proxy_pass' },
          { from: 'app', to: 'db', badge: 'SQL', color: 'amber', dash: 'dashed' }
        ]
      }
    }
  ];

  var state = {
    spec: null,
    sel: null,
    guides: false,
    def: { color: 'blue', width: 2, dash: 'solid', motion: 'flow' }
  };

  var $ = function (id) { return document.getElementById(id); };
  var el = {
    board: $('board'), preview: $('preview'), docTitle: $('docTitle'),
    topStatus: $('topStatus'),
    nodeList: $('nodeList'), edgeList: $('edgeList'), facList: $('facList'),
    specBox: $('specBox'), codeStatus: $('codeStatus'), toast: $('toast'), logoGrid: $('logoGrid'),
    logoSearch: $('logoSearch'), logoCat: $('logoCat'), presetSel: $('presetSel'),
    defSwatches: $('defSwatches')
  };

  /* ------------------------------------------------------------ helpers */

  function clone(o) { return JSON.parse(JSON.stringify(o)); }

  function uid(prefix) {
    var ids = Object.keys(state.spec.nodes || {});
    var n = 1;
    while (ids.indexOf(prefix + n) >= 0) n++;
    return prefix + n;
  }

  function toneColor(name) {
    for (var i = 0; i < TONES.length; i++) if (TONES[i][0] === name) return TONES[i][1];
    return null;
  }

  function toast(msg) {
    el.toast.textContent = msg;
    el.toast.classList.add('is-on');
    clearTimeout(toast._t);
    toast._t = setTimeout(function () { el.toast.classList.remove('is-on'); }, 1500);
  }

  /* Edge bisa array lama ["A","B","label",true] atau objek baru. Semua kode
     panel memakai objek; normalisasi terjadi sekali saat load/apply.
     Edges may be legacy arrays or objects; the panel only works with objects. */
  function normalizeEdges() {
    var spec = state.spec;
    if (!Array.isArray(spec.edges)) { spec.edges = []; return; }
    spec.edges = spec.edges.map(function (e) {
      if (e && !Array.isArray(e)) {
        if (!e.color) e.color = e.back ? 'green' : 'blue';
        if (e.motion === undefined) e.motion = 'flow';
        return e;
      }
      var back = !!e[3];
      return {
        from: e[0], to: e[1],
        badge: e[2] || '',
        back: back,
        color: back ? 'green' : 'blue',
        width: 2,
        dash: 'solid',
        motion: 'flow'
      };
    });
  }

  function nodeArr(id) {
    var n = state.spec.nodes[id];
    if (!Array.isArray(n)) state.spec.nodes[id] = n = [id, '', 'circle-dot', 'process'];
    return n;
  }

  function rebuildColumns() {
    var spec = state.spec;
    var ids = Object.keys(spec.nodes);
    var groups = [];
    ids.forEach(function (id) {
      var col = Math.max(1, parseInt(spec.nodes[id]._col || 1, 10) || 1);
      while (groups.length < col) groups.push([]);
      groups[col - 1].push(id);
    });
    if (!groups.length) return [['A']];
    spec.columns = groups.map(function (list) {
      if (list.length > 1) {
        /* Tumpukan biasa tetap array; hanya kolom ber-"grid" jadi objek. */
        if (spec.nodes[list[0]]._plain) return list;
        var want = parseInt(spec.nodes[list[0]]._grid, 10) || list.length;
        var g = Math.max(2, Math.min(4, list.length, want));
        return { nodes: list, grid: g };
      }
      return [list[0]];
    });
    return spec.columns;
  }

  /* Susun "columns" dari spec yang ditempel. Tanpa ini "columns" (dan "grid")
     dari JSON hilang dan tiap node dapat kolom sendiri. Keep a pasted spec's
     own "columns" and "grid": otherwise every node lands in its own column. */
  function assignColumns(spec) {
    var ids = Object.keys(spec.nodes || {}), seen = {};
    var cols = Array.isArray(spec.columns) ? spec.columns : [];
    if (!cols.length) {
      ids.forEach(function (id, i) { spec.nodes[id]._col = i + 1; delete spec.nodes[id]._grid; });
      return;
    }
    cols.forEach(function (c, i) {
      var list = Array.isArray(c) ? c : (c && Array.isArray(c.nodes) ? c.nodes : null);
      if (!list) return;
      var grid = (!Array.isArray(c) && c && c.grid) ? parseInt(c.grid, 10) || 0 : 0;
      list.forEach(function (id) {
        if (!Object.prototype.hasOwnProperty.call(spec.nodes, id) || seen[id]) return;
        seen[id] = 1;
        spec.nodes[id]._col = i + 1;
        if (grid > 1) spec.nodes[id]._grid = grid;
        else delete spec.nodes[id]._grid;
        /* Kolom yang ditulis sebagai array biasa tidak boleh dikasih "grid":
           itu tumpukan satu kolom, bukan kotak-kotak. A column written as a
           plain array is a stack, not a grid. */
        if (Array.isArray(c) && list.length > 1) spec.nodes[id]._plain = 1;
        else delete spec.nodes[id]._plain;
      });
    });
    var base = cols.length;
    ids.filter(function (id) { return !seen[id]; }).forEach(function (id, i) {
      spec.nodes[id]._col = base + 1 + Math.floor(i / 4);
      delete spec.nodes[id]._grid;
      delete spec.nodes[id]._plain;
    });
  }

  /* _col hanya untuk editor; columns yang dipublikasikan tetap dari rebuild.
     _col is editor-only; the published columns come from rebuildColumns(). */
  function cleanSpec() {
    var spec = clone(state.spec);
    Object.keys(spec.nodes || {}).forEach(function (id) {
      var n = spec.nodes[id];
      if (n && typeof n === 'object') { delete n._col; delete n._grid; delete n._plain; }
    });
    delete spec._col;
    return spec;
  }

  /* Blok yang dipublikasikan: sintaks TOPO, sama dengan yang di artikel.
     The published fence is TOPO text, identical to the article. */
  function fence() {
    return '```topology\n' + window.Topo.stringify(cleanSpec()) + '\n```';
  }

  function edgeColor(e) {
    return toneColor(e.color) || (typeof e.color === 'string' && e.color.charAt(0) === '#' ? e.color : '#8b949e');
  }

  /* ------------------------------------------------------------- render */

  function render() {
    var spec = cleanSpec();
    el.preview.innerHTML = '';
    el.preview.className = 'topology';
    delete el.preview.dataset.rendered;
    if (document.activeElement !== el.docTitle) el.docTitle.value = state.spec.title || '';

    var count = Object.keys(state.spec.nodes || {}).length;
    var edgeCount = (state.spec.edges || []).length;
    if (el.topStatus) el.topStatus.textContent = count + ' node · ' + edgeCount + ' edge';
    el.board.classList.toggle('is-empty', count === 0);

    if (count) {
      try {
        window.Topo.render(el.preview, spec);
        /* Ukur ulang setelah DOM tenang supaya kanvas sama dengan artikel.
           Re-measure after the DOM settles so the canvas matches the article. */
        window.Topo.relayout(el.preview);
        /* Diagram horizontal yang menggantikan diagram vertikal bisa terukur
           sebelum DOM lama lepas; kalau lebarnya meledak, gambar sekali lagi.
           A horizontal diagram replacing a vertical one can be measured before
           the old DOM is gone; if its width explodes, draw once more. */
        requestAnimationFrame(function () {
          window.Topo.render(el.preview, spec);
          window.Topo.relayout(el.preview);
        });
      } catch (err) { el.preview.textContent = 'Render error: ' + err.message; }
    }


    syncPanels();
    queueSave();
  }

  function syncPanels() {
    if (document.activeElement !== el.specBox) el.specBox.value = fence();
    renderNodes();
    renderEdges();
    renderLook();
    highlight();
  }

  /* Sintaks ditulis langsung; kanvas mengikuti selama JSON-nya sah.
     The fence is edited in place — the canvas follows while the JSON parses. */
  function codeStatus(kind, msg) {
    el.codeStatus.className = 'code-status' + (kind ? ' is-' + kind : '');
    el.codeStatus.textContent = msg || '';
  }

  function statusLine() {
    var n = Object.keys(state.spec.nodes || {}).length;
    var e = (state.spec.edges || []).length;
    return 'valid · ' + n + ' node · ' + e + ' edge';
  }

  function stripFence(raw) {
    return String(raw)
      .replace(/^\s*```(?:topology|json)?[ \t]*\r?\n/, '')
      .replace(/\r?\n?```\s*$/, '');
  }

  function liveParse() {
    var text = stripFence(el.specBox.value);
    if (!text.trim()) {
      codeStatus('bad', 'kosong');
      return false;
    }

    var next;
    try {
      next = window.Topo.parse(text);
    } catch (err) {
      codeStatus('bad', 'sintaks salah — ' + err.message);
      return false;
    }
    if (!next || !next.nodes || !Object.keys(next.nodes).length) {
      codeStatus('bad', 'butuh minimal satu node');
      return false;
    }

    state.spec = next;
    assignColumns(state.spec);
    normalizeEdges();
    rebuildColumns();
    state.sel = null;

    render();
    codeStatus('ok', statusLine());
    return true;
  }

  function highlight() {
    Array.prototype.forEach.call(el.preview.querySelectorAll('.topo-node'), function (n) {
      n.classList.toggle('is-selected', !!state.sel && n.dataset.node === state.sel);
    });
  }

  /* -------------------------------------------------------------- nodes */

  function renderNodes() {
    var spec = state.spec;
    var ids = Object.keys(spec.nodes);
    el.nodeList.innerHTML = '';

    if (!ids.length) {
      el.nodeList.innerHTML = '<div class="empty">Belum ada node.</div>';
      return;
    }

    ids.forEach(function (id) {
      var n = nodeArr(id);
      var card = document.createElement('div');
      card.className = 'card' + (state.sel === id ? ' is-on' : '');
      card.dataset.node = id;

      var head = document.createElement('div');
      head.className = 'card-head';

      var dot = document.createElement('span');
      dot.className = 'dot';
      dot.style.background = toneColor(n[3]) || '#58a6ff';

      var b = document.createElement('b');
      b.textContent = n[0] || id;

      var idTag = document.createElement('span');
      idTag.className = 'id mono';
      idTag.textContent = id;

      var del = document.createElement('button');
      del.type = 'button';
      del.className = 'btn btn--sm btn--danger btn--icon';
      del.style.marginLeft = 'auto';
      del.textContent = '×';
      del.title = 'Delete node';
      del.addEventListener('click', function () {
        delete state.spec.nodes[id];
        state.spec.edges = state.spec.edges.filter(function (e) {
          return e.from !== id && e.to !== id;
        });
        if (state.sel === id) state.sel = null;
        render();
      });

      head.appendChild(dot);
      head.appendChild(b);
      head.appendChild(idTag);
      head.appendChild(del);
      card.appendChild(head);

      card.addEventListener('click', function (ev) {
        if (ev.target.closest('button')) return;
        state.sel = id;
        render();
      });

      /* Drop logo langsung ke kartu node. */
      card.addEventListener('dragover', function (ev) {
        if (!ev.dataTransfer) return;
        ev.preventDefault();
        card.classList.add('is-drop');
      });
      card.addEventListener('dragleave', function () { card.classList.remove('is-drop'); });
      card.addEventListener('drop', function (ev) {
        ev.preventDefault();
        card.classList.remove('is-drop');
        var logo = ev.dataTransfer.getData('text/x-logo');
        if (!logo) return;
        nodeArr(id)[2] = logo;
        state.sel = id;
        render();
        toast('Logo → ' + id);
      });

      var g2 = document.createElement('div');
      g2.className = 'grid2';

      var lab = document.createElement('label');
      lab.className = 'field';
      lab.innerHTML = '<span>Label</span>';
      var labInp = document.createElement('input');
      labInp.className = 'inp';
      labInp.type = 'text';
      labInp.value = n[0] || '';
      labInp.addEventListener('input', function () { n[0] = labInp.value; render(); });
      lab.appendChild(labInp);
      g2.appendChild(lab);

      var sub = document.createElement('label');
      sub.className = 'field';
      sub.innerHTML = '<span>Sub label</span>';
      var subInp = document.createElement('input');
      subInp.className = 'inp';
      subInp.type = 'text';
      subInp.value = n[1] || '';
      subInp.addEventListener('input', function () { n[1] = subInp.value; render(); });
      sub.appendChild(subInp);
      g2.appendChild(sub);
      card.appendChild(g2);

      var g3 = document.createElement('div');
      g3.className = 'grid3';

      var icon = document.createElement('label');
      icon.className = 'field';
      icon.innerHTML = '<span>Icon</span>';
      var iconInp = document.createElement('input');
      iconInp.className = 'inp mono';
      iconInp.type = 'text';
      iconInp.value = n[2] || '';
      iconInp.placeholder = 'customer / stack:docker';
      iconInp.addEventListener('input', function () { n[2] = iconInp.value; render(); });
      icon.appendChild(iconInp);
      g3.appendChild(icon);

      var kind = document.createElement('label');
      kind.className = 'field';
      kind.innerHTML = '<span>Kind</span>';
      var kindSel = document.createElement('select');
      kindSel.className = 'inp';
      KINDS.forEach(function (k) {
        var o = document.createElement('option');
        o.value = k; o.textContent = k;
        if ((n[3] || 'process') === k) o.selected = true;
        kindSel.appendChild(o);
      });
      kindSel.addEventListener('change', function () { n[3] = kindSel.value; render(); });
      kind.appendChild(kindSel);
      g3.appendChild(kind);

      var col = document.createElement('label');
      col.className = 'field';
      col.innerHTML = '<span>Col</span>';
      var colInp = document.createElement('input');
      colInp.className = 'inp';
      colInp.type = 'number';
      colInp.min = '1';
      colInp.max = '9';
      colInp.value = String(parseInt(n._col || 1, 10));
      colInp.addEventListener('input', function () {
        var col = Math.max(1, parseInt(colInp.value, 10) || 1);
        if (col !== n._col) { delete n._grid; n._col = col; }
        rebuildColumns();
        render();
      });
      col.appendChild(colInp);
      g3.appendChild(col);
      card.appendChild(g3);

      var href = document.createElement('label');
      href.className = 'field';
      href.style.marginBottom = '0';
      href.innerHTML = '<span>Link (opsional)</span>';
      var hrefInp = document.createElement('input');
      hrefInp.className = 'inp';
      hrefInp.type = 'url';
      hrefInp.placeholder = 'https://…';
      hrefInp.value = n[4] || '';
      hrefInp.addEventListener('input', function () {
        if (hrefInp.value) n[4] = hrefInp.value;
        else if (n.length > 4) n.length = 4;
        render();
      });
      href.appendChild(hrefInp);
      card.appendChild(href);

      el.nodeList.appendChild(card);
    });
  }

  /* -------------------------------------------------------------- edges */

  function renderEdges() {
    var spec = state.spec;
    var ids = Object.keys(spec.nodes);
    el.edgeList.innerHTML = '';

    if (!ids.length) {
      el.edgeList.innerHTML = '<div class="empty">Tambah node dulu.</div>';
      return;
    }
    if (!spec.edges.length) {
      el.edgeList.innerHTML = '<div class="empty">Belum ada kabel.</div>';
    }

    spec.edges.forEach(function (e, i) {
      var card = document.createElement('div');
      card.className = 'card';

      var head = document.createElement('div');
      head.className = 'card-head';

      var dot = document.createElement('span');
      dot.className = 'dot';
      dot.style.background = e.back ? '#3fb950' : edgeColor(e);

      var b = document.createElement('b');
      b.textContent = e.back ? 'Back' : 'Flow';

      var del = document.createElement('button');
      del.type = 'button';
      del.className = 'btn btn--sm btn--danger btn--icon';
      del.style.marginLeft = 'auto';
      del.textContent = '×';
      del.addEventListener('click', function () {
        spec.edges.splice(i, 1);
        render();
      });

      head.appendChild(dot);
      head.appendChild(b);
      head.appendChild(del);
      card.appendChild(head);

      /* from -> to */
      var line = document.createElement('div');
      line.className = 'edge-line';

      [['From', 'from'], ['To', 'to']].forEach(function (pair) {
        var lab = document.createElement('label');
        lab.className = 'field';
        lab.style.margin = '0';
        lab.innerHTML = '<span>' + pair[0] + '</span>';
        var sel = document.createElement('select');
        sel.className = 'inp';
        ids.forEach(function (id) {
          var o = document.createElement('option');
          o.value = id; o.textContent = id;
          if (e[pair[1]] === id) o.selected = true;
          sel.appendChild(o);
        });
        sel.addEventListener('change', function () { e[pair[1]] = sel.value; render(); });
        lab.appendChild(sel);
        line.appendChild(lab);
        if (pair[1] === 'from') {
          var arw = document.createElement('div');
          arw.className = 'arw';
          arw.textContent = e.back ? '←' : '→';
          line.appendChild(arw);
        }
      });
      card.appendChild(line);

      var badge = document.createElement('label');
      badge.className = 'field';
      badge.style.marginTop = '8px';
      badge.innerHTML = '<span>Label / konteks</span>';
      var badgeInp = document.createElement('input');
      badgeInp.className = 'inp';
      badgeInp.type = 'text';
      badgeInp.placeholder = e.back ? 'Response' : 'Request';
      badgeInp.value = e.badge || '';
      badgeInp.addEventListener('input', function () {
        if (badgeInp.value) e.badge = badgeInp.value;
        else delete e.badge;
        render();
      });
      badge.appendChild(badgeInp);
      card.appendChild(badge);

      /* color + width */
      var sw = document.createElement('div');
      sw.className = 'field';
      var swHead = document.createElement('span');
      swHead.textContent = 'Warna kabel';
      sw.appendChild(swHead);
      var swWrap = document.createElement('div');
      swWrap.className = 'swatches';

      TONES.forEach(function (t) {
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'sw' + ((e.color || '') === t[0] ? ' is-on' : '');
        btn.style.background = t[1];
        btn.style.color = t[1];
        btn.title = t[0];
        btn.addEventListener('click', function () {
          if (e.color === t[0]) delete e.color;
          else e.color = t[0];
          render();
        });
        swWrap.appendChild(btn);
      });

      var none = document.createElement('button');
      none.type = 'button';
      none.className = 'sw sw--none' + (!e.color ? ' is-on' : '');
      none.title = 'Auto (biru/hijau)';
      none.addEventListener('click', function () { delete e.color; render(); });
      swWrap.appendChild(none);

      sw.appendChild(swWrap);
      card.appendChild(sw);

      var g3 = document.createElement('div');
      g3.className = 'grid3';

      var wLab = document.createElement('label');
      wLab.className = 'field';
      wLab.style.margin = '0';
      wLab.innerHTML = '<span>Tebal</span>';
      var wInp = document.createElement('input');
      wInp.className = 'inp';
      wInp.type = 'number';
      wInp.min = '1';
      wInp.max = '8';
      wInp.step = '0.5';
      wInp.value = String(e.width || 2);
      wInp.addEventListener('input', function () {
        var v = parseFloat(wInp.value);
        if (v > 0) e.width = v; else delete e.width;
        render();
      });
      wLab.appendChild(wInp);
      g3.appendChild(wLab);

      var dLab = document.createElement('label');
      dLab.className = 'field';
      dLab.style.margin = '0';
      dLab.innerHTML = '<span>Gaya</span>';
      var dSel = document.createElement('select');
      dSel.className = 'inp';
      ['solid', 'dashed', 'dotted', 'dash'].forEach(function (d) {
        var o = document.createElement('option');
        o.value = d; o.textContent = d;
        if ((e.dash || 'solid') === d) o.selected = true;
        dSel.appendChild(o);
      });
      dSel.addEventListener('change', function () {
        if (dSel.value === 'solid') delete e.dash;
        else e.dash = dSel.value;
        render();
      });
      dLab.appendChild(dSel);
      g3.appendChild(dLab);

      var mLab = document.createElement('label');
      mLab.className = 'field';
      mLab.style.margin = '0';
      mLab.innerHTML = '<span>Motion</span>';
      var mSel = document.createElement('select');
      mSel.className = 'inp';
      [['flow', 'flow'], ['none', 'none']].forEach(function (m) {
        var o = document.createElement('option');
        o.value = m[0]; o.textContent = m[1];
        if ((e.motion || 'flow') === m[0]) o.selected = true;
        mSel.appendChild(o);
      });
      mSel.addEventListener('change', function () {
        if (mSel.value === 'flow') delete e.motion;
        else e.motion = mSel.value;
        render();
      });
      mLab.appendChild(mSel);
      g3.appendChild(mLab);
      card.appendChild(g3);

      var backRow = document.createElement('label');
      backRow.className = 'switch';
      backRow.style.marginTop = '9px';
      var cb = document.createElement('input');
      cb.type = 'checkbox';
      cb.checked = !!e.back;
      cb.addEventListener('change', function () {
        if (cb.checked) { e.back = true; if (!e.color || e.color === 'blue') e.color = 'green'; }
        else { delete e.back; if (e.color === 'green') delete e.color; }
        render();
      });
      backRow.appendChild(cb);
      backRow.appendChild(document.createTextNode('Jalur balik (response)'));
      card.appendChild(backRow);

      el.edgeList.appendChild(card);
    });
  }

  /* --------------------------------------------------------------- look */

  function renderLook() {
    var spec = state.spec;
    if (document.activeElement !== $('fTitle')) $('fTitle').value = spec.title || '';
    Array.prototype.forEach.call($('fVertical').children, function (b) {
      var on = spec.vertical === false ? b.dataset.v === '0' : b.dataset.v === '1';
      b.classList.toggle('is-on', on);
    });
    $('fBadges').checked = spec.badges !== false;
    if (document.activeElement !== $('fFlow')) $('fFlow').value = (spec.legend && spec.legend.flow) || '';
    if (document.activeElement !== $('fBack')) $('fBack').value = (spec.legend && spec.legend.back) || '';
    if (document.activeElement !== $('fFacLabel')) $('fFacLabel').value = spec.facilitiesLabel || '';

    var facs = Array.isArray(spec.facilities) ? spec.facilities : [];
    el.facList.innerHTML = '';
    if (!facs.length) el.facList.innerHTML = '<div class="empty">Belum ada chip.</div>';

    facs.forEach(function (f, i) {
      var icon = Array.isArray(f) ? f[0] : '';
      var label = Array.isArray(f) ? f[1] : f;
      var row = document.createElement('div');
      row.className = 'row';

      var ic = document.createElement('input');
      ic.className = 'inp mono';
      ic.style.flex = '0 0 96px';
      ic.placeholder = 'server';
      ic.value = icon;
      ic.addEventListener('input', function () {
        state.spec.facilities[i] = [ic.value, lab.value];
        render();
      });

      var lab = document.createElement('input');
      var labInp = document.createElement('input');
      labInp.className = 'inp';
      labInp.placeholder = 'Core';
      labInp.value = label;
      labInp.addEventListener('input', function () {
        state.spec.facilities[i] = [ic.value, labInp.value];
        render();
      });
      lab.appendChild(labInp);

      var del = document.createElement('button');
      del.type = 'button';
      del.className = 'btn btn--sm btn--danger btn--icon';
      del.textContent = '×';
      del.addEventListener('click', function () {
        state.spec.facilities.splice(i, 1);
        render();
      });

      row.appendChild(ic);
      row.appendChild(labInp);
      row.appendChild(del);
      el.facList.appendChild(row);
    });

    /* default cable swatches */
    if (!el.defSwatches.childElementCount) {
      TONES.forEach(function (t) {
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'sw';
        btn.style.background = t[1];
        btn.style.color = t[1];
        btn.title = t[0];
        btn.dataset.tone = t[0];
        btn.addEventListener('click', function () {
          state.def.color = t[0];
          paintDefaults();
        });
        el.defSwatches.appendChild(btn);
      });
    }
    paintDefaults();
  }

  function paintDefaults() {
    Array.prototype.forEach.call(el.defSwatches.children, function (b) {
      b.classList.toggle('is-on', b.dataset.tone === state.def.color);
    });
    $('defWidth').value = String(state.def.width);
    $('defDash').value = state.def.dash;
    $('defMotion').value = state.def.motion;
  }

  /* -------------------------------------------------------------- logos */

  function renderLogos() {
    if (!window.AlurLogos) return;
    var sel = el.logoCat;
    if (!sel.options.length) {
      var all = document.createElement('option');
      all.value = 'all';
      all.textContent = 'All · ' + AlurLogos.total;
      sel.appendChild(all);
      AlurLogos.categories().forEach(function (c) {
        var o = document.createElement('option');
        o.value = c.id;
        o.textContent = c.label + ' · ' + c.count;
        sel.appendChild(o);
      });
    }

    el.logoGrid.innerHTML = '';
    AlurLogos.search(el.logoSearch.value, sel.value).slice(0, 300).forEach(function (entry) {
      var tile = document.createElement('div');
      tile.className = 'tile';
      tile.draggable = true;
      tile.title = entry.id + ' — drag to a node';

      var res = AlurLogos.resolve(entry.id);
      if (res && res.kind === 'file') {
        var img = document.createElement('img');
        img.src = res.href;
        img.alt = entry.name;
        img.loading = 'lazy';
        img.draggable = false;
        tile.appendChild(img);
      } else if (res && res.kind === 'sprite') {
        tile.innerHTML = '<svg viewBox="0 0 24 24"><use href="' + res.ref + '"></use></svg>';
      }

      tile.addEventListener('dragstart', function (ev) {
        ev.dataTransfer.setData('text/x-logo', entry.id);
        ev.dataTransfer.setData('text/plain', entry.id);
        ev.dataTransfer.effectAllowed = 'copy';
      });

      tile.addEventListener('click', function () {
        if (!state.sel) { toast('Pilih node dulu'); return; }
        nodeArr(state.sel)[2] = entry.id;
        render();
        toast('Logo → ' + state.sel);
      });

      el.logoGrid.appendChild(tile);
    });
  }

  /* --------------------------------------------------------- drag target */

  function wirePreviewDrop() {
    el.preview.addEventListener('dragover', function (ev) {
      var node = ev.target.closest && ev.target.closest('.topo-node');
      if (!node) return;
      ev.preventDefault();
      if (ev.dataTransfer) ev.dataTransfer.dropEffect = 'copy';
      Array.prototype.forEach.call(el.preview.querySelectorAll('.topo-node'), function (n) {
        n.classList.toggle('is-drop', n === node);
      });
    });

    el.preview.addEventListener('dragleave', function (ev) {
      var node = ev.target.closest && ev.target.closest('.topo-node');
      if (node) node.classList.remove('is-drop');
    });

    el.preview.addEventListener('drop', function (ev) {
      var node = ev.target.closest && ev.target.closest('.topo-node');
      if (!node) return;
      ev.preventDefault();
      var logo = ev.dataTransfer.getData('text/x-logo') || ev.dataTransfer.getData('text/plain');
      node.classList.remove('is-drop');
      if (!logo) return;
      var id = node.dataset.node;
      if (!id || !state.spec.nodes[id]) return;
      nodeArr(id)[2] = logo;
      state.sel = id;
      render();
      toast('Logo → ' + id);
    });
  }

  /* --------------------------------------------------------------- save */

  function queueSave() {
    clearTimeout(queueSave._t);
    queueSave._t = setTimeout(function () {
      try { localStorage.setItem(SAVE_KEY, JSON.stringify(cleanSpec())); } catch (err) {}
    }, 300);
  }

  function loadInitial() {
    var spec = null;
    try {
      var raw = localStorage.getItem(SAVE_KEY);
      if (raw) spec = JSON.parse(raw);
    } catch (err) {}
    if (!spec || !spec.nodes) spec = clone(PRESETS[0].spec);

    state.spec = spec;
    assignColumns(spec);
    normalizeEdges();
    if (!dock0()) setPane('nodes');
  }

  function dock0() { return $('dock').classList.contains('is-open'); }

  /* ------------------------------------------------------------- events */

  var PANE_SIDE = { nodes: 'right', edges: 'right', logos: 'right', look: 'right', json: 'right' };
  var PANE_TITLE = { nodes: 'Nodes', edges: 'Edges', logos: 'Logos', look: 'Look', json: 'Topology' };

  function setPane(name) {
    var dock = $('dock');
    var same = dock.classList.contains('is-open') && dock.dataset.pane === name;
    var next = same ? null : name;

    Array.prototype.forEach.call(document.querySelectorAll('.dock-tab'), function (t) {
      t.classList.toggle('is-on', t.dataset.pane === next);
    });
    Array.prototype.forEach.call(document.querySelectorAll('.pane'), function (p) {
      p.classList.toggle('is-on', p.dataset.pane === next);
    });

    dock.classList.toggle('is-open', !!next);
    dock.dataset.pane = next || '';
    dock.dataset.side = next ? PANE_SIDE[next] : 'right';
    var opener = $('dockOpen');
    if (opener) opener.setAttribute('aria-expanded', next ? 'true' : 'false');
    if (next) {
      $('dockTitle').textContent = PANE_TITLE[next] || next;
      if (next === 'logos') renderLogos();
      if (next === 'json') {
        el.specBox.value = fence();
        codeStatus('ok', statusLine());
      }
    }
    syncStageInsets();
  }

  function syncStageInsets() {
    var stage = $('stage'), dock = $('dock');
    if (!stage || !dock) return;
    if (!dock.classList.contains('is-open')) {
      stage.style.right = '';
      stage.style.bottom = '';
      return;
    }
    var r = dock.getBoundingClientRect();
    var vw = window.innerWidth, vh = window.innerHeight;
    if (!r.width || !r.height) { stage.style.right = ''; stage.style.bottom = ''; return; }
    /* Di layar sempit panel selalu jadi bottom sheet, jadi inset-nya juga
       bawah. On narrow screens the panel is always a bottom sheet, so the
       inset has to be the bottom one. */
    var side = (window.innerWidth <= 900) ? 'bottom' : dock.dataset.side;
    if (side === 'right') {
      stage.style.right = Math.round(Math.max(0, Math.min(vw - r.left + 10, vw * 0.45))) + 'px';
      stage.style.bottom = '';
    } else {
      stage.style.bottom = Math.round(Math.max(0, Math.min(vh - r.top + 10, vh * 0.55))) + 'px';
      stage.style.right = '';
    }
  }

  Array.prototype.forEach.call(document.querySelectorAll('.dock-tab'), function (tab) {
    tab.addEventListener('click', function () { setPane(tab.dataset.pane); });
  });

  $('dockClose').addEventListener('click', function () { setPane(null); });

  /* Di layar sempit inspector tertutup; tombol ini membukanya kembali. */
  $('dockOpen').addEventListener('click', function () {
    var open = $('dock').classList.contains('is-open');
    setPane(open ? null : 'nodes');
  });

  (function () {
    var grip = $('dockResize'), dock = $('dock'), sy = 0, ow = 0, oh = 0, on = false;

    grip.addEventListener('pointerdown', function (ev) {
      ev.preventDefault();
      on = true;
      sy = ev.clientY;
      ow = dock.offsetWidth;
      oh = dock.offsetHeight;
      dock.style.height = oh + 'px';
      dock.style.maxHeight = 'none';
      dock.classList.add('is-dragging');
      grip.setPointerCapture(ev.pointerId);
    });

    grip.addEventListener('pointermove', function (ev) {
      if (!on) return;
      var h = Math.max(170, Math.min(window.innerHeight - 160, oh + sy - ev.clientY));
      dock.style.height = h + 'px';
    });

    function end(ev) {
      if (!on) return;
      on = false;
      dock.classList.remove('is-dragging');
      try { grip.releasePointerCapture(ev.pointerId); } catch (e) {}
      syncStageInsets();
    }
    grip.addEventListener('pointerup', end);
    grip.addEventListener('pointercancel', end);
  })();

  window.addEventListener('resize', function () { syncStageInsets(); });

  PRESETS.forEach(function (p) {
    var o = document.createElement('option');
    o.value = p.id;
    o.textContent = p.label;
    el.presetSel.appendChild(o);
  });

  el.presetSel.addEventListener('change', function () {
    var p = PRESETS.filter(function (x) { return x.id === el.presetSel.value; })[0];
    el.presetSel.value = '';
    if (!p) return;
    var n = Object.keys(state.spec.nodes || {}).length;
    if (n > 1 && !confirm('Replace the current diagram (' + n + ' nodes) with "' + p.label + '"?')) return;
    state.spec = clone(p.spec);
    state.sel = null;
    assignColumns(state.spec);
    normalizeEdges();
    render();
    toast(p.label);
  });

  $('addNode').addEventListener('click', function () {
    var id = uid('N');
    state.spec.nodes[id] = [id, 'Sub label', 'circle-dot', 'process'];
    state.spec.nodes[id]._col = 1;
    rebuildColumns();
    state.sel = id;
    render();
  });

  $('addEdge').addEventListener('click', function () {
    var ids = Object.keys(state.spec.nodes);
    if (ids.length < 2) { toast('Butuh minimal dua node'); return; }
    state.spec.edges.push({
      from: ids[0],
      to: ids[1],
      color: state.def.color,
      width: state.def.width,
      dash: state.def.dash === 'solid' ? undefined : state.def.dash,
      motion: state.def.motion === 'flow' ? undefined : state.def.motion
    });
    var e = state.spec.edges[state.spec.edges.length - 1];
    if (e.dash === undefined) delete e.dash;
    if (e.motion === undefined) delete e.motion;
    render();
  });

  $('addFac').addEventListener('click', function () {
    state.spec.facilities = state.spec.facilities || [];
    state.spec.facilities.push(['circle-dot', 'Chip']);
    render();
  });

  function setTitle(v) {
    if (v) state.spec.title = v;
    else delete state.spec.title;
    if (document.activeElement !== el.docTitle) el.docTitle.value = state.spec.title || '';
    if (document.activeElement !== $('fTitle')) $('fTitle').value = state.spec.title || '';
    queueSave();
  }

  el.docTitle.addEventListener('input', function () { setTitle(el.docTitle.value); });

  $('fTitle').addEventListener('input', function (e) {
    setTitle(e.target.value);
    render();
  });

  Array.prototype.forEach.call($('fVertical').children, function (b) {
    b.addEventListener('click', function () {
      state.spec.vertical = b.dataset.v !== '0';
      render();
    });
  });

  $('fBadges').addEventListener('change', function (e) {
    state.spec.badges = e.target.checked;
    render();
  });

  function setLegend(which, value) {
    state.spec.legend = state.spec.legend || {};
    if (value) state.spec.legend[which] = value;
    else delete state.spec.legend[which];
    render();
  }

  $('fFlow').addEventListener('input', function (e) { setLegend('flow', e.target.value); });
  $('fBack').addEventListener('input', function (e) { setLegend('back', e.target.value); });

  /* Terapkan konteks ke semua kabel: ini yang membuat "Request/Response" jadi
     label nyata di tiap kabel, bukan cuma legenda.
     Apply the context to every cable so Request/Response becomes a real label
     on each edge, not just a legend. */
  $('applyCtx').addEventListener('click', function () {
    var flow = ($('fFlow').value || '').trim();
    var back = ($('fBack').value || '').trim();
    if (!flow && !back) { toast('Isi label dulu'); return; }
    state.spec.edges.forEach(function (e) {
      var label = e.back ? back : flow;
      if (label) e.badge = label;
      else delete e.badge;
    });
    render();
    toast('Konteks diterapkan ke ' + state.spec.edges.length + ' kabel');
  });

  $('clearCtx').addEventListener('click', function () {
    state.spec.edges.forEach(function (e) { delete e.badge; });
    render();
    toast('Label kabel dikosongkan');
  });

  $('defWidth').addEventListener('input', function (e) {
    state.def.width = parseFloat(e.target.value) || 2;
  });
  $('defDash').addEventListener('change', function (e) { state.def.dash = e.target.value; });
  $('defMotion').addEventListener('change', function (e) { state.def.motion = e.target.value; });

  $('fFacLabel').addEventListener('input', function (e) {
    if (e.target.value) state.spec.facilitiesLabel = e.target.value;
    else delete state.spec.facilitiesLabel;
    render();
  });

  var codeTimer = null;

  el.specBox.addEventListener('input', function () {
    clearTimeout(codeTimer);
    codeTimer = setTimeout(liveParse, 220);
  });

  el.specBox.addEventListener('blur', function () {
    clearTimeout(codeTimer);
    if (liveParse()) el.specBox.value = fence();
  });

  el.specBox.addEventListener('keydown', function (e) {
    if (e.key === 'Tab') {
      e.preventDefault();
      var s = this.selectionStart, t = this.selectionEnd;
      this.value = this.value.slice(0, s) + '  ' + this.value.slice(t);
      this.selectionStart = this.selectionEnd = s + 2;
      clearTimeout(codeTimer);
      liveParse();
    }
  });

  function fallbackCopy(text) {
    var ta = document.createElement('textarea');
    ta.value = text;
    ta.style.position = 'fixed';
    ta.style.opacity = '0';
    document.body.appendChild(ta);
    ta.select();
    try { document.execCommand('copy'); toast('Tersalin ```topology'); }
    catch (err) { toast('Gagal menyalin — pakai Export'); }
    document.body.removeChild(ta);
  }

  function copyFence() {
    var text = fence();
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(
        function () { toast('Tersalin ```topology'); },
        function () { fallbackCopy(text); });
    } else {
      fallbackCopy(text);
    }
  }

  $('copyBtn').addEventListener('click', copyFence);

  $('exportBtn').addEventListener('click', function () {
    var blob = new Blob([fence() + '\n'], { type: 'text/markdown' });
    var a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'topology.md';
    a.click();
    setTimeout(function () { URL.revokeObjectURL(a.href); }, 1000);
    toast('Export topology.md');
  });

  $('guidesBtn').addEventListener('change', function (e) {
    state.guides = !!e.target.checked;
    $('stage').classList.toggle('is-guides', state.guides);
  });

  el.logoSearch.addEventListener('input', renderLogos);
  el.logoCat.addEventListener('change', renderLogos);

  el.preview.addEventListener('click', function (e) {
    var card = e.target.closest && e.target.closest('.topo-node');
    if (!card) return;
    state.sel = card.dataset.node || null;
    render();
  });

  /* ----------------------------------------------------------- bootstrap */

  loadInitial();
  rebuildColumns();
  render();
  renderLogos();
  wirePreviewDrop();
  paintDefaults();

  var rt;
  window.addEventListener('resize', function () {
    clearTimeout(rt);
    rt = setTimeout(render, 200);
  });
})();
</script>
</body>
</html>